{
  "expo": {
    "name": "PropertPro Mobile",
    "slug": "PropertPro Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ChatGPT Image May 14, 2025, 08_05_02 PM.png",
    "scheme": "myapp",
    "userInterfaceStyle": "light",                            
    "newArchEnabled": true, 

    "splash": {
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "light",
      "backgroundColor": "#ffffff",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },

    "android": {
      "backgroundColor": "#ffffff",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": ["expo-router", "expo-font", "expo-web-browser"],

    "experiments": {
      "typedRoutes": true
    }
  }
}